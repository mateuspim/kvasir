# `make env` copies this to `.env` and fills in STRATA_KEY_FILE and RENDER_GID
# for this machine; then set STRATA_DATA_DIR. Paths must be absolute: with the
# default DOCKER=pkexec docker the environment is reset and ~ is not expanded.

# Model data: GGUFs, Strata's prepared pack, MTP draft, presets (~105 GB for
# Q2_0). Put it on an NVMe drive: Strata reads the 29 GB lookup shard from
# here while generating, so a SATA SSD or HDD costs decode speed.
STRATA_DATA_DIR=/srv/strata-data

# API key, one line, mode 0600. `make key` creates it; clients such as
# opencode read the same file.
STRATA_KEY_FILE=/home/you/.config/local-llm/strata.key

STRATA_PORT=8080

# nvidia or amd: picks compose/<vendor>.yml for GPU access.
GPU_VENDOR=nvidia
# Image per card (docs/guide/hardware.md): 0.2.7-cuda13 for RTX 20-50 with
# driver 580+, 0.2.7-cuda12 for older NVIDIA, 0.2.7-rocm-gfx120x / -gfx110x /
# -gfx1151 for AMD.
STRATA_IMAGE=ghcr.io/niko1221/strata:0.2.7-cuda13
# AMD only: numeric id of the host's render group (getent group render).
RENDER_GID=

# How docker is invoked. pkexec avoids joining the docker group, which is
# root-equivalent (docs/adr/0003). `sudo docker` works too; plain `docker`
# if you have accepted that trade-off.
DOCKER=pkexec docker

# What fits your RAM: docs/guide/hardware.md. Q2_0 needs about 44 GB
# (34 GB of experts plus ~10 GB for the OS), IQ3_XXS about 53 GB.
FAMILY=qwen
MODEL=Q2_0
CONTEXT=128k
KV=int8
VISION=on
TUNE=skip
