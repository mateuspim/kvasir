# Copy this file to `.env` and adjust.

# OpenAI-compatible endpoint port (llama-swap proxy)
LLAMA_SWAP_PORT=8080

# Where the GGUF weights live. Kept off /mnt/Tools deliberately: that is a SATA
# SSD (~530 MB/s) while /mnt/FastGames is Gen4 NVMe (~7000 MB/s). Model load
# time scales directly with this, and any model that does not fit in RAM will
# page from here during inference.
MODELS_DIR=/mnt/FastGames/llm-models

# Optional: HF token, only needed for gated repos. The models in models.conf
# are all Apache-2.0 / open and do not require it.
HF_TOKEN=
