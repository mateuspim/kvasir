# Copy this file to `.env` and adjust. Paths must be absolute: docker runs
# through pkexec, which neither passes your environment through nor expands ~.

# Model data: GGUFs, Strata's prepared pack, MTP draft, presets (~105 GB for
# Q2_0). Keep it on NVMe (/mnt/sleipnir), not the SATA SSD (/mnt/gungnir):
# Strata reads the 29 GB lookup shard from here while generating.
STRATA_DATA_DIR=/mnt/sleipnir/llm-models/strata-data

# API key, one line, mode 0600. `make key` creates it. opencode reads the same
# file via {file:...} in ~/.config/opencode/opencode.json.
STRATA_KEY_FILE=/home/pym/.config/local-llm/strata.key

STRATA_PORT=8080
STRATA_IMAGE=ghcr.io/niko1221/strata:0.2.7-cuda13

# Q2_0 matched IQ3_S on Akita's hard canary and is the fastest. IQ3_XXS
# (43 GB of experts) is the next step up and still fits in 60 GB of RAM.
FAMILY=qwen
MODEL=Q2_0
CONTEXT=128k
KV=int8
VISION=on
TUNE=skip
